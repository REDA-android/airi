{
  "services": {
    "api": {
      "root": "server/apps/api",
      "entrypoint": "src/app.ts"
    },
    "auth": {
      "root": "server/apps/auth",
      "entrypoint": "src/server.ts"
    }
  },
  "rewrites": [
    {
      "source": "/api/auth(/.*)?",
      "destination": {
        "type": "service",
        "service": "auth"
      }
    },
    {
      "source": "/api/api(/.*)?",
      "destination": {
        "type": "service",
        "service": "api"
      }
    }
  ]
}
